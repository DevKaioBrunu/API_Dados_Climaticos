# Valores públicos para execução local com Node.js 22.13+.
# Copie para .env e execute: node --env-file=.env backend/src/index.js
# A API permanece na porta fixa 3000; PORT não é lida pelo código atual.
LOG_LEVEL=info
HTTP_TIMEOUT_MS=5000
HTTP_RETRIES=2
HTTP_RETRY_DELAY_MS=300
METRICS_HOST=127.0.0.1
METRICS_PORT=9100
# Use inteiros positivos nas opções HTTP. Na implementação atual, 0 cai no default.
# No Compose, METRICS_HOST e METRICS_PORT são definidos pelo próprio YAML.
# As demais variáveis deste arquivo não são repassadas automaticamente ao container.
